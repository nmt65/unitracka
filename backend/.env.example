NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
JWT_SECRET=schimba-acest-secret-in-productie
JWT_EXPIRES_IN=7d
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
CNP_PEPPER=schimba-acest-pepper-pentru-cnp
RESET_TOKEN_MINUTES=30
DB_DIALECT=sqlite
DATABASE_URL=./data/unitracka.sqlite

# Pentru PostgreSQL/MySQL seteaza DB_DIALECT=postgres sau mysql si foloseste un URL compatibil.
# DATABASE_URL=postgres://user:password@localhost:5432/unitracka

DEMO_EMAIL=demo@unitracka.ro
DEMO_PASSWORD=Demo1234!
ADMIN_EMAIL=admin@unitracker.ro
ADMIN_PASSWORD=
BOOTSTRAP_ADMIN=false
UNIVERSITY_EMAIL=admitere@unibuc.ro
SEED_DEMO=true

OPENAI_API_KEY=
OPENAI_DOCUMENT_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_DOCUMENT_MODEL=gemini-2.5-flash
GEMINI_ADVISOR_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash
GEMINI_REQUEST_TIMEOUT_MS=25000
AI_DOCUMENT_DAILY_LIMIT=40
AI_ADVISOR_DAILY_LIMIT=20

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=UniTracka <no-reply@unitracka.ro>
