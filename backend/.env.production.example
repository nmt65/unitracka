NODE_ENV=production
PORT=4000
APP_URL=https://unitrack.example.ro
CORS_ORIGIN=https://unitrack.example.ro,https://www.unitrack.example.ro
TRUST_PROXY=true
JWT_SECRET=genereaza-un-secret-lung
JWT_EXPIRES_IN=7d
COOKIE_SAMESITE=none
COOKIE_SECURE=true
CNP_PEPPER=genereaza-un-pepper-separat-pentru-cnp
RESET_TOKEN_MINUTES=30
EMAIL_VERIFICATION_MINUTES=10
PASSKEY_RP_NAME=UniTrack
PASSKEY_RP_ID=unitrack.example.ro
PASSKEY_ORIGIN=https://unitrack.example.ro
PASSKEY_CHALLENGE_MINUTES=5

DB_DIALECT=postgres
DATABASE_URL=postgres://user:password@localhost:5432/unitrack

SEED_DEMO=false
BOOTSTRAP_ADMIN=true
ADMIN_EMAIL=admin@unitrack.example.ro
ADMIN_PASSWORD=schimba-parola-asta

OPENAI_API_KEY=
OPENAI_DOCUMENT_MODEL=gpt-4o-mini
OPENAI_ADVISOR_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_DOCUMENT_MODEL=gemini-2.5-flash
GEMINI_ADVISOR_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash
GEMINI_REQUEST_TIMEOUT_MS=25000
AI_DOCUMENT_DAILY_LIMIT=40
AI_ADVISOR_DAILY_LIMIT=20

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DOCUMENT_STORAGE_BUCKET=admission-documents
DOCUMENT_STORAGE_TIMEOUT_MS=15000
FILE_SCAN_URL=
FILE_SCAN_TOKEN=
FILE_SCAN_REQUIRED=false
FILE_SCAN_TIMEOUT_MS=15000

OFFICIAL_REGISTRY_API_URL=
OFFICIAL_REGISTRY_API_TOKEN=
OFFICIAL_REGISTRY_TIMEOUT_MS=15000
QUALIFIED_SIGNATURE_API_URL=
QUALIFIED_SIGNATURE_API_TOKEN=
QUALIFIED_SIGNATURE_TIMEOUT_MS=15000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=UniTrack <no-reply@unitrack.example.ro>
SMTP_FORCE_IPV4=true
